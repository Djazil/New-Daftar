rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // ==========================================
    // 1. ملفات المستخدمين (Users)
    // ==========================================
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // ==========================================
    // 2. طلبات الاشتراك والتفعيل
    // ==========================================
    match /subscriptions/{subId} {
      allow read: if true;
      allow write: if true;
    }

    match /subscription_requests/{requestId} {
      allow read, write: if true;
    }

    match /deleted_subscriptions/{docId} {
      allow read, write: if true;
    }

    // ==========================================
    // 3. بيانات الأساتذة والأقسام (Teachers)
    // ==========================================
    match /teachers/{teacherUid}/{document=**} {
      allow read, write: if true;
    }

    // ==========================================
    // 4. سجلات التدقيق الإداري
    // ==========================================
    match /admin_audit_logs/{logId} {
      allow read, write: if true;
    }

    // ==========================================
    // 5. اختبار الاتصال
    // ==========================================
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
