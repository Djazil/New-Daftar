rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // دالة التحقق من أن المستخدم مسجل الدخول
    function isAuthenticated() {
      return request.auth != null;
    }

    // دالة التحقق من أن المستخدم هو المشرف الرئيسي djazild@gmail.com
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email != null && request.auth.token.email.lower() == 'djazild@gmail.com');
    }

    // ==========================================
    // 1. إدارة الاشتراكات وتسجيلات الأساتذة
    // ==========================================
    match /subscriptions/{subId} {
      // القراءة متاحة للجميع للتحقق من حالة الحساب والمزامنة الحية في لوحة المدير
      allow read: if true;

      // إنشاء طلب تسجيل جديد أو التعديل متاح للأساتذة وللمدير
      allow write: if true;
    }

    match /subscription_requests/{requestId} {
      allow read, write: if true;
    }

    // ==========================================
    // 2. اختبار الاتصال
    // ==========================================
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
