{
  "entities": {
    "UserProfile": {
      "title": "User Profile & Account Status",
      "description": "Represents an authenticated teacher or admin user account and activation status",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["teacher", "admin"] },
        "status": { "type": "string", "enum": ["pending", "active", "suspended", "deleted"] },
        "isFirstTimeSetupDone": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "role", "status"]
    },
    "Subscription": {
      "title": "Teacher Subscription",
      "description": "Represents a teacher account record and activation status",
      "type": "object",
      "properties": {
        "teacherEmail": { "type": "string" },
        "teacherName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "planId": { "type": "string" },
        "status": { "type": "string", "enum": ["none", "pending", "active", "suspended", "deleted"] },
        "amountDZD": { "type": "number" },
        "requestedAt": { "type": "string" },
        "activatedAt": { "type": "string" },
        "isLifetime": { "type": "boolean" },
        "activatedByAdminEmail": { "type": "string" },
        "adminNotes": { "type": "string" },
        "deletedAt": { "type": "string" }
      },
      "required": ["teacherEmail", "status"]
    },
    "AdminAuditLog": {
      "title": "Admin Audit Log",
      "description": "Audit record for administrative operations (activation, suspension, cancellation, deletion)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "actionType": { "type": "string" },
        "adminEmail": { "type": "string" },
        "targetTeacherEmail": { "type": "string" },
        "timestamp": { "type": "string" },
        "details": { "type": "string" },
        "result": { "type": "string" }
      },
      "required": ["id", "actionType", "adminEmail", "targetTeacherEmail", "timestamp", "result"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "UserProfile",
      "description": "Collection of user profiles and activation statuses"
    },
    "/subscriptions/{teacherEmailKey}": {
      "schema": "Subscription",
      "description": "Collection storing teacher subscription records indexed by encoded teacher email"
    },
    "/admin_audit_logs/{logId}": {
      "schema": "AdminAuditLog",
      "description": "Collection of administrative audit trail logs"
    }
  }
}
